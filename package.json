{
    "name": "root",
    "version": "6.0.4-alpha26",
    "scripts": {
        "start": "pnpm run storybook",
        "version": "./update-version.sh",
        "build": "pnpm -r run build",
        "typedoc": "typedoc --readme none --disableSources --tsconfig packages/core/tsconfig.json",
        "serve-docs": "http-server packages/core/gen-docs",
        "storybook:run": "storybook dev -p 9009 --no-open",
        "watch:core": "pnpm --dir packages/core run watch",
        "storybook": "concurrently \"pnpm run storybook:run\" \"pnpm run watch:core\"",
        "build-storybook": "pnpm run build && storybook build -o storybook-build/",
        "prod-storybook": "pnpm run build-storybook && pnpm exec http-server storybook-build -p 9009",
        "test": "pnpm --dir packages/core run test",
        "test-source": "pnpm --dir packages/source run test",
        "test-cells": "pnpm --dir packages/cells run test",
        "lint": "pnpm run test:lint && pnpm -r run lint",
        "test:lint": "node --test config/test/*.test.mjs"
    },
    "type": "commonjs",
    "author": "Glide",
    "license": "MIT",
    "workspaces": [
        "./packages/core",
        "./packages/cells",
        "./packages/source"
    ],
    "devDependencies": {
        "@babel/cli": "^7.28.3",
        "@babel/core": "^7.28.5",
        "@babel/plugin-proposal-class-properties": "^7.18.6",
        "@babel/preset-env": "^7.28.5",
        "@babel/preset-react": "^7.28.5",
        "@babel/preset-typescript": "^7.28.5",
        "@eslint/compat": "^1.4.1",
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "^9.39.1",
        "@faker-js/faker": "^7.6.0",
        "@linaria/core": "^6.3.0",
        "@linaria/react": "^6.3.0",
        "@storybook/addon-docs": "^10.2.5",
        "@storybook/addon-links": "^10.2.5",
        "@storybook/react-vite": "^10.2.5",
        "@storybook/react-webpack5": "^10.2.5",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/lodash": "^4.17.20",
        "@types/node": "^24.10.0",
        "@types/react": "^19.2.2",
        "@types/react-dom": "^19.2.2",
        "@types/react-syntax-highlighter": "^15.5.13",
        "@typescript-eslint/eslint-plugin": "^8.46.3",
        "@typescript-eslint/parser": "^8.46.3",
        "@typescript-eslint/typescript-estree": "^8.46.3",
        "@vitejs/plugin-react": "^5.1.0",
        "@wyw-in-js/babel-preset": "^0.8.1",
        "@wyw-in-js/cli": "^1.0.6",
        "@wyw-in-js/vite": "^1.0.6",
        "babel-loader": "^10.0.0",
        "chokidar-cli": "^3.0.0",
        "clean-css-cli": "^5.6.3",
        "concurrently": "^9.2.1",
        "esbuild": "^0.25.12",
        "eslint": "^9.39.1",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-sonarjs": "^3.0.5",
        "eslint-plugin-unicorn": "^43.0.2",
        "http-server": "^14.1.1",
        "jsdom": "^26.1.0",
        "lodash": "^4.17.21",
        "marked": "^16.4.1",
        "mini-css-extract-plugin": "^2.9.4",
        "prettier": "^3.6.2",
        "react": "19.2.0",
        "react-dom": "19.2.0",
        "react-laag": "^2.0.5",
        "react-number-format": "^5.4.4",
        "react-responsive-carousel": "^3.2.23",
        "react-syntax-highlighter": "^15.6.6",
        "resolve-typescript-plugin": "^2.0.1",
        "storybook": "^10.2.5",
        "tsc-esm-fix": "^3.1.2",
        "typedoc": "^0.28.14",
        "typescript": "^5.9.3",
        "vite": "^7.1.12",
        "vitest": "^0.34.6",
        "vitest-canvas-mock": "^0.3.3",
        "webpack": "^5.102.1"
    },
    "overrides": {
        "storybook": "$storybook"
    },
    "packageManager": "pnpm@10.29.2",
    "pnpm": {
        "overrides": {
            "react": "$react",
            "react-dom": "$react-dom"
        }
    }
}
